meta {
  name: 06 Crear libro (201)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/libros
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "titulo": "Dune",
    "anioPublicacion": 1965,
    "autorId": {{autorId}}
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("libroId", res.body.id);
}
