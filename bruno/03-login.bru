meta {
  name: 03 Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("token", res.body.token);
}

docs {
  Guarda el token en la variable {{token}} para las siguientes peticiones.
}
